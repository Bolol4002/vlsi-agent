[TEMPLATE]
# PictureThis API Configuration for qwen2.5-coder
# Copy this file to .env and fill in your API key.

LLM_API_KEY=your_api_key_here
LLM_MODEL=qwen2.5-coder-16k:latest
LLM_BASE_URL=https://aiapi.picturethis.work/v1

# Alternative: Native Ollama URL (uncomment if needed)
# OLLAMA_BASE_URL=https://aiapi.picturethis.work
# USE_OLLAMA_NATIVE=true
